{
  "root_dir": "GMM_Training/",
  "name": "G1",
  "registered_name": "visier_config",
  "train": {
    "logging": {
      "terminal_output_to_txt": true,
      "log_wandb": true,
      "wandb_project_name": "GMM",
      "log_every_n_steps": 10
    },
    "save": {
      "enabled": true,
      "every_n_steps": 5000,
      "best_k": 1
    },
    "training": {
      "batch_size": 64,
      "num_steps": 3000000,
      "num_data_workers": 16
    },
    "validation": {
      "enabled": true,
      "batch_size": 64,
      "num_data_workers": 8,
      "every_n_steps": 1500,
      "num_steps_per_epoch": 50
    },
    "datamodule_class": "CLDDataModule",
    "trajdata_source_train": [
      "nusc_trainval-train",
      "nusc_trainval-train_val"
    ],
    "trajdata_source_valid": [
      "nusc_trainval-val"
    ],
    "rebuild_cache": false
  },
  "env": {
    "name": "trajdata",
    "data_generation_params": {
      "trajdata_centric": "agent",
      "trajdata_only_types": [
        "vehicle"
      ],
      "trajdata_predict_types": [
        "vehicle"
      ],
      "trajdata_incl_map": true,
      "trajdata_max_agents_distance": 50,
      "trajdata_standardize_data": true,
      "max_neighbor_num": null,
      "incl_robot_future": false
    },
    "rasterizer": {
      "raster_size": 224,
      "pixel_size": 1.0,
      "ego_center": [
        -0.5,
        0.0
      ],
      "no_map_fill_value": -1.0,
      "num_sem_layers": 3,
      "include_hist": false
    }
  },
  "algo": {
    "future_num_frames": 20,
    "history_num_frames": 20,
    "dt": 0.1,
    "map_encoder_model_arch": "resnet18",
    "grid_feature_dim": 32,
    "center_history_out_dim": 128,
    "norm_info_center": [
      [
        -1.254605,
        0.000775,
        1.303665,
        5.517106,
        2.129704
      ],
      [
        3.533255,
        0.202021,
        2.934695,
        2.405262,
        0.440991
      ]
    ],
    "norm_info_neighbor": [
      [
        -0.434552,
        0.668156,
        0.902879,
        4.625183,
        1.85828
      ],
      [
        9.972197,
        9.134619,
        2.403248,
        2.225015,
        0.636914
      ]
    ],
    "norm_info_ego": [
      [
        -0.313144,
        1.776826,
        4.318217
      ],
      [
        33.538803,
        23.737097,
        3.300695
      ]
    ],
    "action_norm_info_center": [
      [
        -0.006135,
        0.000198
      ],
      [
        2.16333,
        0.056355
      ]
    ],
    "history_feature_dim": 64,
    "state_encoder_out_dim": 64,
    "context_encoder_hidden_dim": 128,
    "context_encoder_out_dim": 128,
    "time_emb_dim": 32,
    "diffusion_hidden_dim": 64,
    "dilations": [
      1,
      2,
      4,
      8
    ],
    "num_heads": 4,
    "sigma_gmm_scale": 3,
    "Dynamics": {
      "max_steer": 0.25,
      "max_yawvel": 2.0,
      "acce_bound": [
        -3,
        3
      ],
      "vbound": [
        0,
        8
      ]
    },
    "ddim_steps": 20,
    "scene_agent_max_neighbor_dist": 30,
    "disable_control_on_stationary": "any_speed",
    "moving_speed_th": 2,
    "ppo_actor_hidden": 64,
    "optim_params": {
      "learning_rate": {
        "initial": 0.00001,
        "weight_decay": 0.0001
      }
    },
    "num_Gaussian": 8,
    "n_diffusion_steps": 100
  },
  "seed": 42
}
